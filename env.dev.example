# ── DEV environment config ───────────────────────────────────────────────────
# Copy to .env.dev and fill in with the OFFICE project. Used when DEPLOYMENT_ENVIRONMENT=dev (default).

GCP_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-project-adk-staging-dev

# NOTE: distinct display name — deploy matches create-or-update by display_name,
# so reusing the concierge's name would overwrite it.
AGENT_NAME=deck-preview-probe-dev
AGENT_DISPLAY_NAME=Deck Preview Probe (Dev)
AGENT_DESCRIPTION=Probe: can GE chat show slide images bundled in the agent (data URIs) and navigate them with a Slider or Tabs, no storage. Synthetic data only. DEV deployment.
